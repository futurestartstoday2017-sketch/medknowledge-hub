# .gitignore：Git（GitHub）に含めないファイルの一覧です。

# Python仮想環境（各自のPCで作り直せるため、共有しない）
.venv/

# Pythonが自動で作るキャッシュファイル
__pycache__/
*.pyc

# テストツール（pytest）が自動で作るキャッシュ
.pytest_cache/

# パスワードやAPIキーなどの秘密情報を書くファイル
.env
.env.*
.streamlit/secrets.toml
secrets.toml

# データベースファイル（自分で登録したデータが入るため、公開しない）
*.db
*.sqlite
*.sqlite3

# データベースのバックアップ（*.db でも除外されますが、フォルダごと明示しておく）
data/backups/

# 実データの取り込み用CSV（AIが調査して作成したものを含む。公開リポジトリには上げない）
data/imports/

# どちらのデータベース（架空データ／実データ）を使うかの、このPCだけの設定
data/app_config.json
